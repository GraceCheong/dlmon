generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  displayName   String?   // Teacher's preferred display name (Settings)
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For Credentials provider
  language      String    @default("ko")  // UI language preference
  aiMode        Boolean   @default(true)   // Advanced AI features toggle
  accounts      Account[]
  sessions      Session[]
  courses       Course[]
  members       Member[]  // Students managed by this teacher
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Member {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String   @default("student")
  userId    String   // The teacher who manages this member
  user      User     @relation(fields: [userId], references: [id])
  submissions Submission[]
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id             String          @id @default(cuid())
  title          String
  description    String?
  level          String
  type           String
  weeks          Int             @default(15)
  startDate      DateTime?
  endDate        DateTime?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  curriculumPlan CurriculumPlan?
  lessons        Lesson[]
  syllabus       Syllabus?
}

model CurriculumPlan {
  id       String @id @default(cuid())
  courseId String @unique
  data     String
  course   Course @relation(fields: [courseId], references: [id])
}

model Syllabus {
  id       String @id @default(cuid())
  courseId String @unique
  content  String
  course   Course @relation(fields: [courseId], references: [id])
}

model Lesson {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  order       Int
  status      String        @default("draft")
  slug        String        @unique
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  course      Course        @relation(fields: [courseId], references: [id])
  blocks      LessonBlock[]
  assignments Assignment[]
}

model LessonBlock {
  id       String @id @default(cuid())
  lessonId String
  type     String
  content  String
  order    Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])
}

model Assignment {
  id          String       @id @default(cuid())
  lessonId    String
  title       String
  type        String       // 'speaking' or 'writing'
  prompt      String       // The question or text to read
  dueDate     DateTime?
  lesson      Lesson       @relation(fields: [lessonId], references: [id])
  submissions Submission[]
}

model Submission {
  id              String     @id @default(cuid())
  assignmentId    String
  memberId        String
  contentUrl      String?    // URL to audio file (for speaking)
  contentText     String?    // Text input (for writing)
  aiScore         Int?       // Score out of 100
  aiFeedback      String?    // AI generated feedback
  status          String     @default("pending") // 'pending', 'graded'
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  member          Member     @relation(fields: [memberId], references: [id])
  createdAt       DateTime   @default(now())
}
