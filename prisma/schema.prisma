generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(cuid())
  name               String?
  displayName        String? // Teacher's preferred display name (Settings)
  email              String?               @unique
  emailVerified      DateTime?
  image              String?
  password           String? // For Credentials provider
  language           String                @default("ko") // UI language preference
  aiMode             Boolean               @default(true) // Advanced AI features toggle
  aiProvider         String                @default("ollama") // "ollama" | "claude-cli"
  accounts           Account[]
  sessions           Session[]
  courses            Course[]
  members            Member[] // Students managed by this teacher
  rubrics            WritingRubric[]
  writingEvaluations WritingEvaluation[]   @relation("TeacherEvaluations")
  importJobs         MediaImportJob[]
  uploadedFiles      UploadedFile[]
  prompts            Prompt[]
  lessonPlans        LessonPlan[]
  generatedItems     GeneratedItem[]
  templates          Template[]
  publishedTemplates MarketplaceTemplate[] @relation("PublishedTemplates")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model Member {
  id          String       @id @default(cuid())
  name        String
  email       String? // optional in MVP — teacher-managed records may not have an email
  role        String       @default("student")
  userId      String // The teacher who manages this member
  className   String? // Optional class/cohort label (e.g. "초급반-A")
  metadata    String? // Flexible JSON blob — SQLite stores as TEXT, parse client-side
  deletedAt   DateTime? // Soft delete; queries should filter `deletedAt: null`
  user        User         @relation(fields: [userId], references: [id])
  submissions Submission[]
  joinedAt    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id             String          @id @default(cuid())
  title          String
  description    String?
  level          String
  type           String
  weeks          Int             @default(15)
  startDate      DateTime?
  endDate        DateTime?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  curriculumPlan CurriculumPlan?
  lessons        Lesson[]
  syllabus       Syllabus?
}

model CurriculumPlan {
  id       String @id @default(cuid())
  courseId String @unique
  data     String
  course   Course @relation(fields: [courseId], references: [id])
}

model Syllabus {
  id       String @id @default(cuid())
  courseId String @unique
  content  String
  course   Course @relation(fields: [courseId], references: [id])
}

model Lesson {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  order       Int
  status      String        @default("draft")
  slug        String        @unique
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  course      Course        @relation(fields: [courseId], references: [id])
  blocks      LessonBlock[]
  assignments Assignment[]
}

model LessonBlock {
  id       String @id @default(cuid())
  lessonId String
  type     String
  content  String
  order    Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])
}

model Assignment {
  id             String                 @id @default(cuid())
  lessonId       String
  title          String
  type           String // 'speaking' or 'writing'
  prompt         String // The question or text to read
  dueDate        DateTime?
  // Phase 3: writing-evaluation fields. Optional so existing rows stay valid.
  hskLevel       String? // e.g. "HSK1".."HSK6", nullable for non-leveled assignments
  targetAudience String? // e.g. "직장인 입문자", "유학 준비생"
  rubricId       String? // Pre-generated rubric used by default for evaluations
  lesson         Lesson                 @relation(fields: [lessonId], references: [id])
  submissions    Submission[]
  attachments    AssignmentAttachment[]
}

model AssignmentAttachment {
  id             String   @id @default(cuid())
  assignmentId   String
  uploadedFileId String
  createdAt      DateTime @default(now())

  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedFile UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, uploadedFileId])
}

model Submission {
  id                       String              @id @default(cuid())
  assignmentId             String
  memberId                 String
  contentUrl               String? // URL to audio file (for speaking)
  contentText              String? // Text input (for writing)
  // Legacy fields — kept for back-compat with old grading UI. New code should
  // read scores via WritingEvaluation, not these fields.
  aiScore                  Int? // Score out of 100 (legacy quick grade)
  aiFeedback               String? // AI generated feedback (legacy)
  status                   String              @default("pending") // 'pending', 'graded'
  // Phase 3: writing-evaluation fields.
  rubricId                 String? // Rubric used (or chosen for) this submission
  languageValidationStatus String? // e.g. "ok", "wrong_language", "unsupported"
  assignment               Assignment          @relation(fields: [assignmentId], references: [id])
  member                   Member              @relation(fields: [memberId], references: [id])
  evaluations              WritingEvaluation[]
  createdAt                DateTime            @default(now())
}

/**
 * Async YouTube import job. Tracks every stage from metadata fetch through
 * AI content generation. Internal audio file paths are stored here but MUST
 * NOT appear in any public API response — filter them at the route layer.
 */
model MediaImportJob {
  id               String    @id @default(cuid())
  userId           String
  status           String    @default("queued")
  // source
  sourceType       String    @default("youtube")
  sourceUrl        String
  videoId          String?
  videoTitle       String?
  channelName      String?
  durationSeconds  Int?
  thumbnailUrl     String?
  // transcript
  transcriptText   String?
  transcriptSource String? // youtube_manual | youtube_auto | whisper | manual
  transcriptStatus String? // fetched | unavailable | failed
  // audio — internal only, never exposed to the frontend
  audioStatus      String? // not_needed | downloaded | processing | transcribed | deleted | failed
  audioDurationSec Float?
  audioSizeBytes   Int?
  audioDeletedAt   DateTime?
  audioStoragePath String? // *** NEVER return this field from any API route ***
  // STT
  sttProvider      String?
  sttModel         String?
  sttRawResponse   String?
  // AI
  aiProvider       String?
  aiModel          String?
  aiRawResponse    String?
  aiResult         String? // JSON: ImportedYouTubeAIResult
  // request options
  targetAudience   String?
  hskLevel         String?
  transcriptPolicy String? // JSON: TranscriptPolicy
  outputOptions    String? // JSON: OutputOptions
  limits           String? // JSON: ImportJobLimits
  // error
  jobError         String?
  errorCode        String?
  // timing
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User                   @relation(fields: [userId], references: [id])
  transcriptChunks MediaTranscriptChunk[]
  savedContent     ImportedMediaContent?
}

model MediaTranscriptChunk {
  id         String   @id @default(cuid())
  jobId      String
  chunkIndex Int
  text       String
  startSec   Float?
  endSec     Float?
  createdAt  DateTime @default(now())

  job MediaImportJob @relation(fields: [jobId], references: [id])
}

model ImportedMediaContent {
  id           String   @id @default(cuid())
  jobId        String   @unique
  saveAs       String // lesson_material | lesson_plan_section | template | generated_item
  courseId     String?
  lessonId     String?
  lessonPlanId String?
  materialId   String?
  content      String // JSON: saved (possibly edited) ImportedYouTubeAIResult
  savedAt      DateTime @default(now())

  job MediaImportJob @relation(fields: [jobId], references: [id])
}

/**
 * A reusable rubric describing how to grade a writing submission. Generated
 * once during assignment setup (AI-assisted or manual), versioned, and
 * referenced by WritingEvaluation rows. Re-evaluation does NOT regenerate the
 * rubric — it snapshots and reuses it.
 */
model WritingRubric {
  id              String   @id @default(cuid())
  ownerId         String // Teacher (User) who owns this rubric
  courseId        String?
  lessonId        String?
  assignmentId    String?
  hskLevel        String // e.g. "HSK3"
  targetAudience  String // free-text target description
  criteria        String // JSON: { grammar, vocabulary, sentence_structure, ... }
  deductionPolicy String // JSON: { grammar: 25, vocabulary: 20, ... }
  createdByAi     Boolean  @default(true)
  aiProvider      String?
  aiModel         String?
  version         Int      @default(1)
  status          String   @default("active") // 'active' | 'archived'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner       User                @relation(fields: [ownerId], references: [id])
  evaluations WritingEvaluation[]
}

/**
 * One evaluation pass over one Submission with one Rubric. Re-evaluation
 * creates a NEW row (never overwrites): the new row's `previousEvaluationId`
 * points back to the prior version, and `evaluationVersion` is incremented.
 * `rubricSnapshot` captures the rubric state at evaluation time so future
 * rubric edits don't retroactively change historical scores.
 */
model WritingEvaluation {
  id                   String   @id @default(cuid())
  submissionId         String
  teacherId            String
  rubricId             String
  rubricSnapshot       String // JSON: full rubric content captured at eval time
  rubricSource         String // e.g. "default" | "manual" | "ai-regen"
  score100             Float
  score10              Float
  deductions           String // JSON: per-criterion deductions
  sentenceFeedback     String // JSON: array of per-sentence feedback objects
  overallSummary       String
  teacherComment       String?
  aiProvider           String?
  aiModel              String?
  evaluationVersion    Int      @default(1)
  previousEvaluationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  submission Submission    @relation(fields: [submissionId], references: [id])
  rubric     WritingRubric @relation(fields: [rubricId], references: [id])
  teacher    User          @relation("TeacherEvaluations", fields: [teacherId], references: [id])
}

/**
 * Uploaded file (PDF, HWP, HWPX). Viewer resource only — never AI input.
 * HWP/HWPX files are converted to PDF server-side; storagePath and
 * convertedPath are internal and must never be exposed via any API response.
 */
model UploadedFile {
  id               String   @id @default(cuid())
  userId           String
  originalName     String // Display name (original filename)
  fileType         String // 'pdf' | 'hwp' | 'hwpx'
  fileSize         Int // bytes
  storagePath      String // *** internal — never expose via API ***
  conversionStatus String   @default("not_needed") // 'not_needed' | 'pending' | 'processing' | 'done' | 'failed'
  convertedPath    String? // *** internal — never expose via API ***
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id])
  assignmentAttachments AssignmentAttachment[]
}

/**
 * Saved generation prompt. Teachers can save and reuse prompts across
 * lesson plan generation, Chinese vocabulary/sentence generation, etc.
 */
model Prompt {
  id             String   @id @default(cuid())
  userId         String
  title          String
  content        String // The prompt text
  targetAudience String? // One of the 6 standard audience values
  hskLevel       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  lessonPlans LessonPlan[]
}

/**
 * AI-generated lesson plan. Created via /api/ai/lesson-plans/generate and
 * saved explicitly by the teacher. content is a JSON string.
 */
model LessonPlan {
  id             String   @id @default(cuid())
  userId         String
  promptId       String?
  title          String
  targetAudience String?
  hskLevel       String?
  content        String // JSON: structured lesson plan
  aiProvider     String?
  aiModel        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  prompt Prompt? @relation(fields: [promptId], references: [id])
}

/**
 * Result from the Chinese vocabulary / example-sentence generator.
 * Stored when the teacher explicitly saves a generation. content is JSON.
 */
model GeneratedItem {
  id             String   @id @default(cuid())
  userId         String
  mode           String // 'vocabulary' | 'sentence'
  topic          String
  hskLevel       String?
  targetAudience String?
  count          Int
  grammarPattern String?
  context        String?
  content        String // JSON: array of generated items
  aiProvider     String?
  aiModel        String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

/**
 * Private teacher template. Can be published to the marketplace as a
 * snapshot (MarketplaceTemplate). Editing the private template does NOT
 * update the marketplace snapshot — republish is required.
 */
model Template {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  targetAudience String?
  hskLevel       String?
  type           String   @default("lesson") // 'lesson' | 'curriculum' | 'textbook_placeholder'
  content        String // JSON: template content / structure
  sourceType     String   @default("manual") // 'manual' | 'ai' | 'textbook_placeholder' | 'copied'
  textbookRef    String? // placeholder for future textbook DB linkage
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                  @relation(fields: [userId], references: [id])
  marketplaceEntries MarketplaceTemplate[]
}

/**
 * Public marketplace listing. Holds a publish-time snapshot of the template
 * so subsequent edits to the private original do not affect the listing.
 * Unpublishing sets isActive=false; the row is kept for audit purposes.
 */
model MarketplaceTemplate {
  id             String   @id @default(cuid())
  templateId     String
  publisherId    String
  title          String
  description    String?
  targetAudience String?
  hskLevel       String?
  type           String   @default("lesson")
  snapshot       String // JSON: publish-time snapshot of template content — immutable
  copyCount      Int      @default(0)
  isActive       Boolean  @default(true)
  publishedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  template  Template @relation(fields: [templateId], references: [id])
  publisher User     @relation("PublishedTemplates", fields: [publisherId], references: [id])
}
